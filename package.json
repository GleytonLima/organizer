{
  "name": "brain-organizer",
  "productName": "Brain Organizer",
  "version": "0.1.0",
  "description": "Terminais, agentes de IA, tarefas e memória num lugar só — beyond orchestration",
  "main": "src/main/index.js",
  "author": "Gleyton",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "icon": "electron build/render-icon.js",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win",
    "test": "node test/run.js",
    "test:ui": "playwright test -c test/ui",
    "test:coverage": "node test/run.js --coverage"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.93.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "c8": "^12.0.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.bashorganizer.app",
    "productName": "Brain Organizer",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "bin/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "bin/**",
      "node_modules/node-pty/**",
      "node_modules/@agentclientprotocol/**",
      "node_modules/@anthropic-ai/**",
      "node_modules/diff/**",
      "node_modules/zod/**"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Brain Organizer",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
